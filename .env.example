# ===========================================
# HackFlow Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# --- Authentication (Google OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Database (TiDB/MySQL) ---
DATABASE_HOST=
DATABASE_PORT=4000
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=hackflow
DATABASE_SSL_CA=

# For Drizzle ORM connection string
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl={"ca":"CA_CERT_CONTENT"}

# --- Storage ---
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Application ---
APP_URL=http://localhost:3000
QR_HMAC_FALLBACK_SECRET=
